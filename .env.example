APP_NAME=Tandem
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Branding: see config/branding.php for every option
BRANDING_NAME="${APP_NAME}"
BRANDING_TAGLINE="calm mail for busy teams"
BRANDING_LOGO=
BRANDING_WORDMARK=/tandem/tandem-mail-wordmark-purple.svg
BRANDING_COLOR_BRAND=
BRANDING_SHORT_NAME=
BRANDING_THEME_COLOR=
BRANDING_ICON_512=
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tandem
DB_USERNAME=tandem
DB_PASSWORD=tandem

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Tandem: Google OAuth client (fallback when an organization has no own client) and Pub/Sub topic for Gmail push
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PUBSUB_TOPIC=

# Tandem: Google Pub/Sub push verification token appended to the Gmail push endpoint
TANDEM_GMAIL_PUBSUB_TOKEN=

# Single sign-on (see config/sso.php). SSO_FORCE=true switches off password, registration and passkey
# login so the identity provider is the only way in. Google reuses GOOGLE_CLIENT_ID/SECRET unless the
# SSO_GOOGLE_* variables are set; add APP_URL/auth/google/callback to the client's redirect URIs.
SSO_FORCE=false
SSO_GOOGLE_ENABLED=false
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_GOOGLE_HOSTED_DOMAINS=

REVERB_APP_ID=tandem
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Forwarding domain served by the Cloudflare Email Worker (see docs/providers/cloudflare.md)
TANDEM_FORWARDING_DOMAIN=forward.tandem.test
TANDEM_FORWARDING_WEBHOOK_SECRET=

# Default outbound transport for forwarding-only inboxes and autoresponders (smtp|log|ses|resend)
TANDEM_OUTBOUND_MAILER=log

# Application server (php artisan octane:start). Set TRUSTED_PROXIES=* when the app only
# receives traffic through a load balancer or Docker ingress that terminates TLS.
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false
TRUSTED_PROXIES=

# Inertia SSR: `npm run dev` renders through Vite; in production run `php artisan inertia:start-ssr`
# (or the `ssr` service in compose.yaml) and point INERTIA_SSR_URL at it.
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714

# Web Push (generate with: php artisan webpush:vapid)
VAPID_SUBJECT="mailto:${MAIL_FROM_ADDRESS}"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
